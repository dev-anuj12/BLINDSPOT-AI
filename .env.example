# Google Gemini API Key (Server-side ONLY - never expose with NEXT_PUBLIC_)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Name (defaults to gemini-2.5-flash or gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://blindspot-ai.vercel.app
NEXT_PUBLIC_CONTACT_EMAIL=support@blindspot-ai.com

# Optional: Google Analytics 4 (Only activated upon explicit cookie consent)
NEXT_PUBLIC_GA_ID=

# Optional: Google reCAPTCHA v3
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Optional: Sentry Error Monitoring
NEXT_PUBLIC_SENTRY_DSN=
